# Generate a unique signing key, for example: openssl rand -base64 48
JWT_SECRET=
# Bearer token lifetime in milliseconds. Default/recommended: 2 hours.
# JWT_EXPIRATION=7200000
# Authentication is carried by an HttpOnly, Secure, SameSite cookie. Keep Secure=false only for local HTTP development.
# AUTH_SESSION_COOKIE_NAME=AUTOHR_SESSION
# AUTH_SESSION_COOKIE_SECURE=true
# AUTH_SESSION_COOKIE_SAME_SITE=Lax
# AUTH_SESSION_COOKIE_MAX_AGE_MS=7200000
# AUTH_CSRF_COOKIE_NAME=AUTOHR_CSRF
# AUTH_CSRF_HEADER=X-CSRF-Token
# AUTH_CSRF_COOKIE_SECURE=true
# AUTH_CSRF_COOKIE_SAME_SITE=Lax
# Optional independent AES-GCM key for encrypted configuration values. If unset,
# JWT_SECRET is used; keep the selected key stable or stored LLM API keys cannot be decrypted.
# CONFIG_ENCRYPTION_KEY=

# Default standalone database. The unified Ubuntu deployment can start with
# SQLite immediately; switch to the PostgreSQL block below for production HA.
DB_TYPE=sqlite
# Frontend runtime / development endpoints
# VITE_API_BASE_URL=/api
# VITE_DEV_API_TARGET=http://localhost:8080
DB_URL=jdbc:sqlite:autohr.db
DB_USERNAME=
DB_PASSWORD=
SQLITE_FALLBACK_URL=jdbc:sqlite:autohr.db
DB_FALLBACK_ENABLED=true
#MIGRATION_ENABLED=true

# Persistent file paths for IT_ADMIN-managed branding and public site content.
# Use an absolute path in production (for example /var/lib/autohr/site-settings.json).
# SITE_SETTINGS_PATH=.site-settings.json
# SITE_CONTENT_PATH=.site-content.json

# Production PostgreSQL example. Set DB_FALLBACK_ENABLED=false so an outage
# fails visibly instead of writing new data to a local SQLite fallback file.
# DB_TYPE=pgsql
# DB_URL=jdbc:postgresql://127.0.0.1:5432/hrsystem
# DB_USERNAME=hrsystem
# DB_PASSWORD=change-this-password
# DB_FALLBACK_ENABLED=false

# Authentication security state. Redis is required for CAPTCHA, verification codes,
# and rate limiting. Keep REDIS_PASSWORD only in the deployed .env file.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL_ENABLED=false
# AUTH_REDIS_KEY_PREFIX=autohr:auth
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
# AUTH_TRUST_FORWARDED_HEADERS=false
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_LOGIN_RATE_LIMIT_PER_IP=10
# AUTH_LOGIN_RATE_LIMIT_PER_USERNAME=10
# AUTH_CAPTCHA_RATE_LIMIT_PER_IP=30
# AUTH_VERIFICATION_RATE_LIMIT_PER_IP=5
# AUTH_VERIFICATION_RATE_LIMIT_PER_TARGET=3
# Comma-separated default accounts that may keep the documented default password without
# forced change. Leave unset in normal production use. For a temporary itadmin exception:
# AUTH_BOOTSTRAP_DEFAULT_PASSWORD_EXEMPT_USERNAMES=itadmin

# MySQL example:
# DB_TYPE=mysql
# DB_URL=jdbc:mysql://localhost:3306/autohr?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
# DB_USERNAME=root
# DB_PASSWORD=your_password

# Interview page security:
# INTERVIEW_DISABLE_DEVTOOLS_SHORTCUTS=true
# LLM endpoints are public-network only by default to prevent SSRF. Enable only for a trusted
# private/VPC model endpoint protected by network policy.
# LLM_ALLOW_PRIVATE_ADDRESSES=false

# Candidate register verification. SMS, speech recognition, and object storage use separate credentials.
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=inspc@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=inspc@example.com
# SMTP_SSL_ENABLED=false
# SMTP_STARTTLS_ENABLED=true

# S3-compatible object storage. When enabled, completed files are also archived
# to S3, MinIO, or an OSS S3-compatible endpoint. Local files are always retained
# and remain available if archive upload fails.
# S3_ENABLED=false
# Public endpoint used by browser download links. Required when S3 is enabled.
# S3_ENDPOINT=https://s3.example.com
# Set true only when this server can upload through a private/VPC endpoint.
# Browser downloads always use S3_ENDPOINT; uploads use S3_INTERNAL_ENDPOINT.
# S3_INTERNAL_ENDPOINT_ENABLED=false
# S3_INTERNAL_ENDPOINT=https://s3.internal.example.com
# Endpoints require HTTPS and a public address by default. Enable these only for
# trusted MinIO/VPC endpoints; HTTP sends S3 credentials without transport TLS.
# S3_ALLOW_HTTP_ENDPOINTS=false
# S3_ALLOW_PRIVATE_ENDPOINTS=false
# S3_REGION=us-east-1
# S3_BUCKET=autohr
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_PREFIX=autohr
# Set true for MinIO and most self-hosted S3-compatible servers.
# S3_PATH_STYLE_ACCESS=true

# WebRTC relay. Public Ubuntu deploy auto-detects TURN_HOST and TURN_PRIVATE_IP.
# INTERVIEW_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# For public deploy use the server public IP/domain. For LAN testing use the host LAN IP.
# INTERVIEW_TURN_URLS=turn:your-public-ip-or-domain:3478?transport=udp,turn:your-public-ip-or-domain:3478?transport=tcp
# Shared by the backend and coturn REST authentication (use-auth-secret/static-auth-secret).
# Generate a long random value and never expose it to browsers or commit the real value.
# INTERVIEW_TURN_SHARED_SECRET=
# INTERVIEW_TURN_CREDENTIAL_TTL_SECONDS=3600
# TURN_HOST=your-public-ip-or-domain
# TURN_EXTERNAL_IP=your-server-public-ip
# TURN_PRIVATE_IP=your-server-private-ip-if-behind-nat
# Local Docker only: leave unset to auto-detect the coturn container address.
# TURN_DOCKER_PRIVATE_IP=
# TURN_REALM=autohr.local
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49200

# Video recording merge. Ubuntu deploy installs ffmpeg and verifies libvpx-vp9/libopus.
# INTERVIEW_VIDEO_FFMPEG_PATH=ffmpeg
# INTERVIEW_VIDEO_VIDEO_CODEC=libvpx-vp9
# INTERVIEW_VIDEO_AUDIO_CODEC=libopus
# End an active video session only after this many minutes without candidate heartbeat,
# join, SDP/ICE, or recording-upload activity. Missing recordings still get the separate 10-minute grace period.
# INTERVIEW_VIDEO_INACTIVE_TIMEOUT_MINUTES=30
# INTERVIEW_VIDEO_INACTIVE_SCAN_INTERVAL_MS=60000
# INTERVIEW_VIDEO_MISSING_RECORDING_SCAN_INTERVAL_MS=60000

# Aliyun speech-to-text. These are separate from SMS and S3 credentials.
# ALIYUN_STT_ACCESS_KEY_ID=
# ALIYUN_STT_ACCESS_KEY_SECRET=
# ALIYUN_STT_APP_KEY=
# ALIYUN_STT_ENDPOINT=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1

# Resume OCR for scanned PDF resume AI screening. Ubuntu deploy installs Tesseract and Chinese/English language packs.
# RESUME_OCR_ENABLED=true
# RESUME_OCR_TESSERACT_PATH=tesseract
# RESUME_OCR_LANGUAGE=chi_sim+eng
# RESUME_OCR_DPI=200
# RESUME_OCR_MAX_PAGES=5
