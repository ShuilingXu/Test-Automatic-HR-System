#DB_TYPE=sqlite
# Frontend runtime / development endpoints
# VITE_API_BASE_URL=/api
# VITE_DEV_API_TARGET=http://localhost:8080
#DB_URL=jdbc:sqlite:autohr.db
#DB_USERNAME=
#DB_PASSWORD=
#SQLITE_FALLBACK_URL=jdbc:sqlite:autohr.db
#MIGRATION_ENABLED=true

# Production PostgreSQL example. Set DB_FALLBACK_ENABLED=false so an outage
# fails visibly instead of writing new data to a local SQLite fallback file.
DB_TYPE=pgsql
DB_URL=jdbc:postgresql://127.0.0.1:5432/hrsystem
DB_USERNAME=hrsystem
DB_PASSWORD=change-this-password
DB_FALLBACK_ENABLED=false

# MySQL example:
# DB_TYPE=mysql
# DB_URL=jdbc:mysql://localhost:3306/autohr?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=your_password

# Interview page security:
# INTERVIEW_DISABLE_DEVTOOLS_SHORTCUTS=true

# Candidate register verification. SMS, speech recognition, and object storage use separate credentials.
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=inspc@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=inspc@example.com
# SMTP_SSL_ENABLED=false
# SMTP_STARTTLS_ENABLED=true

# S3-compatible object storage. When enabled, completed files are also archived
# to S3, MinIO, or an OSS S3-compatible endpoint. Local files are always retained
# and remain available if archive upload fails.
# S3_ENABLED=false
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=autohr
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_PREFIX=autohr
# Set true for MinIO and most self-hosted S3-compatible servers.
# S3_PATH_STYLE_ACCESS=true

# WebRTC relay. Public Ubuntu deploy auto-detects TURN_HOST and TURN_PRIVATE_IP.
# INTERVIEW_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# For public deploy use the server public IP/domain. For LAN testing use the host LAN IP.
# INTERVIEW_TURN_URLS=turn:your-public-ip-or-domain:3478?transport=udp,turn:your-public-ip-or-domain:3478?transport=tcp
# INTERVIEW_TURN_USERNAME=autohr
# INTERVIEW_TURN_CREDENTIAL=change-this-password
# TURN_HOST=your-public-ip-or-domain
# TURN_EXTERNAL_IP=your-server-public-ip
# TURN_PRIVATE_IP=your-server-private-ip-if-behind-nat
# TURN_USERNAME=autohr
# TURN_CREDENTIAL=change-this-password
# TURN_REALM=autohr.local
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49200

# Video recording merge. Ubuntu deploy installs ffmpeg and verifies libvpx-vp9/libopus.
# INTERVIEW_VIDEO_FFMPEG_PATH=ffmpeg
# INTERVIEW_VIDEO_VIDEO_CODEC=libvpx-vp9
# INTERVIEW_VIDEO_AUDIO_CODEC=libopus

# Aliyun speech-to-text. These are separate from SMS and S3 credentials.
# ALIYUN_STT_ACCESS_KEY_ID=
# ALIYUN_STT_ACCESS_KEY_SECRET=
# ALIYUN_STT_APP_KEY=
# ALIYUN_STT_ENDPOINT=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1

# Resume OCR for scanned PDF resume AI screening. Ubuntu deploy installs Tesseract and Chinese/English language packs.
# RESUME_OCR_ENABLED=true
# RESUME_OCR_TESSERACT_PATH=tesseract
# RESUME_OCR_LANGUAGE=chi_sim+eng
# RESUME_OCR_DPI=200
# RESUME_OCR_MAX_PAGES=5
